# ==========================================
# MOTOR DE COMERCIO - VARIABLES DE ENTORNO Y SECRETOS (SERVIDOR)
# ==========================================
# IMPORTANTE: Ningún secreto debe llevar el prefijo NEXT_PUBLIC_
# En Cloudflare Workers de producción, registrar con: wrangler secret put <KEY>

NODE_ENV=development

# Datos del Comercio Cliente (Inyectados por el Orquestador)
COMMERCE_NAME="Mi Tienda"
COMMERCE_SLUG="mi-tienda"
COMMERCE_WHATSAPP="+5491100000000"
NEXT_PUBLIC_APP_URL="https://mitienda.local"

# Administración y Autenticación
ADMIN_EMAIL=admin@mitienda.com
ADMIN_PASSWORD=admin-secret-2026
SESSION_SECRET=default-session-secret-key-at-least-32-chars-long

# Clave Maestra de Rescate para recuperar el panel de administración offline / sin emails
ADMIN_RECOVERY_KEY=RESCUE-SECRET-KEY-2026

# Proveedor de Correos Transaccionales (Resend)
# Obtené tu clave en https://resend.com/api-keys
RESEND_API_KEY=re_tu_api_key_aqui
# Remitente verificado en Resend (ej: Mi Tienda <onboarding@resend.dev> o Mi Tienda <pedidos@tudominio.com>)
EMAIL_FROM="Mi Tienda <onboarding@resend.dev>"
# Correo donde el dueño/administrador recibe avisos de nuevas compras
ORDER_NOTIFICATIONS_EMAIL=admin@mitienda.com

# Pasarelas de Pago (Servidor)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

