# ==========================================
# AURA STUDIO - VARIABLES DE ENTORNO Y SECRETOS (SERVIDOR)
# ==========================================
# IMPORTANTE: Ningún secreto debe llevar el prefijo NEXT_PUBLIC_
# En Cloudflare Workers de producción, registrar con: wrangler secret put <KEY>

NODE_ENV=development
ADMIN_PASSWORD=aura-admin-secret-2026
SESSION_SECRET=aura-studio-session-secret-key-at-least-32-chars-long

# Clave Maestra de Rescate para recuperar el panel de administración offline / sin emails
ADMIN_RECOVERY_KEY=AURA-RESCUE-SECRET-KEY-2026

# Proveedor de Correos Transaccionales (Resend)
# Obtené tu clave gratuita en https://resend.com/api-keys
RESEND_API_KEY=re_tu_api_key_aqui
# Remitente verificado en Resend (ej: Aura Studio <onboarding@resend.dev> o Aura Studio <pedidos@tudominio.com>)
EMAIL_FROM=Aura Studio <onboarding@resend.dev>
# Correo donde el dueño/administrador recibe avisos de nuevas compras
ORDER_NOTIFICATIONS_EMAIL=admin@aurastudio.com

# Pasarelas de Pago (Servidor)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

